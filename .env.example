# ---------------------------------------------------------------------------
# MLSC Knowledge Assistant — environment configuration
# Copy to `.env` and fill in the provider you intend to use.
#
# NOTE: Retrieval (indexing + /v1/search + all retrieval metrics) runs with NO
# key at all. A key is only required for answer generation and LLM-judged
# evaluation metrics.
# ---------------------------------------------------------------------------

# Which generation backend to use: gemini | anthropic | openai | groq | ollama
MLSC_LLM__PROVIDER=gemini

# --- Google Gemini (default; free tier at https://aistudio.google.com/apikey) --
GOOGLE_API_KEY=

# --- Alternative providers (only the selected one is read) -------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- Optional overrides ------------------------------------------------------
# MLSC_LLM__MODEL=gemini-2.5-flash
# MLSC_RETRIEVAL__TOP_K=6
# MLSC_API__HOST=127.0.0.1
# MLSC_API__PORT=8000
# MLSC_LOG_LEVEL=INFO
